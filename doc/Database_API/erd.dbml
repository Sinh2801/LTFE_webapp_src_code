
Table users {
  id int [pk, increment]
  full_name varchar(100) [not null]
  email varchar(150) [unique, not null]
  password varchar(255) [not null]
  role varchar(20) [not null, note: 'buyer, seller, admin']
  created_at timestamp
  updated_at timestamp
}

Table products {
  id int [pk, increment]
  seller_id int [not null, ref: > users.id]
  name varchar(200) [not null]
  description text
  price decimal(12,2) [not null]
  file_path varchar(500) [not null, note: 'Private file storage path']
  status varchar(20) [not null, note: 'pending, approved, rejected, hidden']
  created_at timestamp
  updated_at timestamp
}

Table orders {
  id int [pk, increment]
  buyer_id int [not null, ref: > users.id]
  total_amount decimal(12,2) [not null]
  status varchar(20) [not null, note: 'pending, paid, cancelled, refunded']
  payment_status varchar(20) [not null, note: 'unpaid, paid, failed, refunded']
  payment_method varchar(50)
  paid_at timestamp
  created_at timestamp
}

Table order_items {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  product_id int [not null, ref: > products.id]
  product_name varchar(200) [not null]
  unit_price decimal(12,2) [not null]
  quantity int [not null, default: 1]
}

Table reviews {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  product_id int [not null, ref: > products.id]
  rating int [not null, note: 'Range 1 to 5']
  comment text
  created_at timestamp

  Indexes {
    (user_id, product_id) [unique]
  }
}

Table downloads_log {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  product_id int [not null, ref: > products.id]
  order_item_id int [ref: > order_items.id]
  downloaded_at timestamp
}
